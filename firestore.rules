rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Authority is canonical only in a UID-addressed, backend-owned document.
    // Email documents, custom claims and client payloads never grant authority.
    function isActivePlatformAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/platform_global_admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/platform_global_admins/$(request.auth.uid)).data.isActive == true &&
        get(/databases/$(database)/documents/platform_global_admins/$(request.auth.uid)).data.role in [
          'PLATFORM_OWNER',
          'PLATFORM_PARTNER',
          'SUPER_ADMIN',
          'FOUNDER',
          'SALES_DIRECTOR',
          'CONSULTANT',
          'SALES_ADVISOR',
          'VIEWER',
          'ADMIN',
          'SUPPORT'
        ];
    }

    // The caller may read only its canonical authority profile. All authority
    // mutations are performed by an audited Admin SDK path.
    match /platform_global_admins/{adminId} {
      allow get: if isActivePlatformAdmin() && adminId == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    // Tenant authority is backend-owned. Preview does not expose a direct
    // tenant-member data path until a versioned membership contract exists.
    match /platform_tenants/{tenantId} {
      allow read: if isActivePlatformAdmin();
      allow create, update, delete: if false;
    }

    match /tenant_memberships/{membershipId} {
      allow read, write: if false;
    }

    match /tenant_aliases/{aliasId} {
      allow read, write: if false;
    }

    match /authority_idempotency/{recordId} {
      allow read, write: if false;
    }

    match /authority_operation_bindings/{bindingId} {
      allow read, write: if false;
    }

    match /authority_audit_events/{eventId} {
      allow read, write: if false;
    }

    match /authority_outbox_events/{eventId} {
      allow read, write: if false;
    }

    match /authority_outbox_delivery/{deliveryId} {
      allow read, write: if false;
    }

    // Public intake infrastructure is backend-owned and never directly
    // observable or mutable by a Firebase client.
    match /public_rate_limit_counters_v1/{counterId} {
      allow read, write: if false;
    }

    match /discovery_intake_idempotency/{recordId} {
      allow read, write: if false;
    }

    match /discovery_intake_idempotency_namespaces_v1/{namespaceId} {
      allow read, write: if false;
    }

    match /discovery_capabilities_v1/{capabilityId} {
      allow read, write: if false;
    }

    match /discovery_completions_v1/{completionId} {
      allow read, write: if false;
    }

    match /discovery_completion_outbox_v1/{outboxId} {
      allow read, write: if false;
    }

    match /discovery_conversation_budgets_v1/{budgetId} {
      allow read, write: if false;
    }

    match /discovery_download_budgets_v1/{budgetId} {
      allow read, write: if false;
    }

    // Structured telemetry and containment policy are backend-owned.
    match /discovery_abuse_telemetry_v1/{eventId} {
      allow read, write: if false;
    }

    match /discovery_abuse_metrics_v1/{metricId} {
      allow read, write: if false;
    }

    match /discovery_containment_policies_v1/{policyId} {
      allow read, write: if false;
    }

    match /discovery_containment_active_v1/{environment} {
      allow read, write: if false;
    }

    match /discovery_containment_audit_v1/{auditId} {
      allow read, write: if false;
    }

    // Discovery records are written only by Admin SDK runtimes. Public token
    // and capability paths are callable Functions, never direct Firestore.
    match /market_discovery_links/{linkId} {
      allow read: if isActivePlatformAdmin();
      allow create, update, delete: if false;
    }

    match /discovery_sessions/{sessionId} {
      allow read: if isActivePlatformAdmin();
      allow create, update, delete: if false;
    }

    match /discovery_reports/{reportId} {
      allow read: if isActivePlatformAdmin();
      allow create, update, delete: if false;
    }

    // Existing administrative and market views remain readable only to a
    // canonical active administrator. Legacy client writers are intentionally
    // closed and must migrate to audited backend paths.
    match /{collection}/{document=**} {
      allow read: if isActivePlatformAdmin() && collection in [
        'platform_leads',
        'platform_clients',
        'platform_subscriptions',
        'platform_licenses',
        'platform_provisioning_jobs',
        'platform_quotes',
        'platform_commissions',
        'platform_sales_advisors',
        'platform_settings',
        'platform_market_state_metadata',
        'market_companies_metadata',
        'market_dataset_metadata',
        'market_imports_history',
        'market_import_jobs',
        'market_companies',
        'platform_organizations',
        'platform_discovery_requests'
      ];
      allow create, update, delete: if false;
    }

    // Inbox content is backend-owned; an authenticated subject may read only
    // its own inbox and notifications.
    match /platform_inbox/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;

      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }
    }

    // Unknown collections and paths are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
