{
  "name": "@aura/intelligence-os",
  "version": "0.0.0-internal",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "sideEffects": false,
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.cjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test:architecture": "npm run build && vitest run tests"
  }
}
