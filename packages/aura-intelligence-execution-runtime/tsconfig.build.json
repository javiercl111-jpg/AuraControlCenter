{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "../../src/modules/intelligence",
    "skipLibCheck": true
  },
  "include": [
    "../../src/modules/intelligence/execution.ts"
  ],
  "exclude": [
    "../../src/modules/intelligence/**/tests/**"
  ]
}
