{
  "name": "aura-control-center",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build --prefix packages/aura-executive-documents && tsc -b && vite build",
    "typecheck:intelligence-os": "npm run typecheck --prefix packages/aura-intelligence-os",
    "build:intelligence-os": "npm run build --prefix packages/aura-intelligence-os",
    "stage:intelligence-os:functions": "npm run build:intelligence-os && npm run stage:functions --prefix packages/aura-intelligence-os",
    "build:functions": "npm run stage:intelligence-os:functions && npm run build --prefix functions",
    "test:intelligence-os:architecture": "npm run test:architecture --prefix packages/aura-intelligence-os",
    "test:intelligence-os:distribution": "npm run stage:intelligence-os:functions && npm run test:distribution --prefix packages/aura-intelligence-os",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "aura-executive-documents": "file:packages/aura-executive-documents",
    "firebase": "^12.15.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.20.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10"
  }
}
