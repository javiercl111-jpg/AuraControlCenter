{
  "name": "aura-control-center",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build --prefix packages/aura-executive-documents && tsc -b && vite build",
    "typecheck:intelligence-os": "npm run typecheck --prefix packages/aura-intelligence-os",
    "build:intelligence-os": "npm run build --prefix packages/aura-intelligence-os",
    "stage:intelligence-os:functions": "npm run build:intelligence-os && npm run stage:functions --prefix packages/aura-intelligence-os",
    "build:functions": "npm run stage:intelligence-os:functions && npm run build --prefix functions",
    "assert:node20": "node scripts/assert-node20.cjs",
    "test:intelligence-os": "vitest run src/modules/intelligence/os",
    "test:intelligence-os:integration": "vitest run src/modules/intelligence/serverIntegrationValidation",
    "test:intelligence-os:architecture": "npm run test:architecture --prefix packages/aura-intelligence-os",
    "test:intelligence-os:distribution": "npm run stage:intelligence-os:functions && npm run test:distribution --prefix packages/aura-intelligence-os",
    "test:intelligence-os:consumption": "npm run test:intelligence-os-consumption --prefix functions",
    "test:firestore-authority-adapter": "vitest run --config functions/tests/vitest.authority.config.ts",
    "test:preview-rules-guard": "node --test scripts/tests/preview-rules-target-guard.test.cjs",
    "test:preview-rules-emulator": "npm run assert:node20 && node functions/tests/emulator/runPreviewRulesEmulator.cjs",
    "test:firestore-authority-emulator": "npm run assert:node20 && npm run stage:intelligence-os:functions && node functions/tests/emulator/runFirestoreAuthorityEmulator.cjs",
    "test:firestore-authority-end-to-end-emulator": "npm run assert:node20 && npm run stage:intelligence-os:functions && node functions/tests/emulator/runAuthorityEndToEndEmulator.cjs",
    "test:firestore-rate-limit-emulator": "npm run assert:node20 && node functions/tests/emulator/runFirestoreRateLimitEmulator.cjs",
    "test:firestore-idempotency-emulator": "npm run assert:node20 && node functions/tests/emulator/runFirestoreIdempotencyEmulator.cjs",
    "test:firestore-capability-emulator": "npm run assert:node20 && node functions/tests/emulator/runFirestoreCapabilityEmulator.cjs",
    "test:discovery-payload-bounds-emulator": "npm run assert:node20 && node functions/tests/emulator/runFirestorePayloadBoundsEmulator.cjs",
    "test:discovery-abuse-telemetry-emulator": "npm run assert:node20 && node functions/tests/emulator/runFirestoreAbuseTelemetryEmulator.cjs",
    "test:discovery-containment-emulator": "npm run assert:node20 && node functions/tests/emulator/runFirestoreContainmentEmulator.cjs",
    "test:public-intake-abuse-matrix": "npm run assert:node20 && vitest run --config functions/tests/publicIntakeAbuseCertification/vitest.config.ts",
    "test:public-intake-abuse-certification": "npm run assert:node20 && node functions/tests/emulator/runPublicIntakeAbuseCertification.cjs",
    "test:preview-runtime-contracts": "npm run assert:node20 && vitest run --config functions/tests/runtimeContracts/vitest.config.ts",
    "test:preview-trust-completion": "npm run assert:node20 && vitest run --config functions/tests/previewTrustCompletion/vitest.config.ts",
    "test:preview-deployment-unit": "npm run assert:node20 && vitest run --config functions/tests/previewDeploymentUnit/vitest.config.ts",
    "test:preview-parameter-binding": "node --test scripts/tests/preview-discovery-parameter-guard.test.cjs",
    "test:preview-invocation-boundary": "node --test scripts/tests/preview-invocation-boundary-guard.test.cjs",
    "guard:preview-invocation-boundary": "node scripts/preview-invocation-boundary-guard.cjs --project=aura-intel-preview --region=us-central1",
    "guard:preview-deployment-unit": "npm run guard:preview-discovery --prefix functions",
    "dry-run:preview-discovery-deploy": "npm run dry-run:preview-discovery --prefix functions",
    "deploy:preview-discovery": "npm run deploy:preview-discovery --prefix functions",
    "test:authority-dark-composition": "vitest run --config functions/tests/vitest.authorityDarkComposition.config.ts",
    "test:authority-dark-handler-composition": "vitest run --config functions/tests/vitest.authorityDarkHandlerComposition.config.ts",
    "test:enterprise-model": "vitest run src/modules/intelligence/enterprise-model",
    "validate:intelligence-os:node20": "npm run assert:node20 && npm run test:intelligence-os:architecture && npm run test:intelligence-os:distribution && npm run test:intelligence-os:consumption && npm run test:intelligence-os:integration && npm run build --prefix functions && npm run test:intelligence-os && npm run test:enterprise-model && npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "aura-executive-documents": "file:packages/aura-executive-documents",
    "firebase": "^12.15.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.20.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10"
  }
}
