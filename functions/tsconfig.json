{
  "compilerOptions": {
    "module": "commonjs",
    "paths": {
      "@aura/intelligence-os/server": [
        "./.generated/aura-intelligence-os/dist/server.d.ts"
      ]
    },
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es2022"
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
